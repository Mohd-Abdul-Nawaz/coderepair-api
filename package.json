{
  "name": "coderepair-api",
  "version": "0.1.0",
  "description": "TypeScript REST service: seeded code-repair task bank with deterministic grading, attempt tracking, and leaderboard.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --test dist/grader.test.js dist/store.test.js",
    "test:src": "npm run build && npm test",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
